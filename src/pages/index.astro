---
import cv from "../collections/cv.json";
import experiences from "../collections/experiences.json";
import projects from "../collections/projects.json";
import WorkCard from "../components/work-card.astro";
import Layout from "../layouts/main.astro";

if (!cv.fileId || cv.fileId.trim() === "") {
	throw new Error(
		"CV fileId is missing in src/collections/cv.json. Set it to the Google Drive file ID before building.",
	);
}

const buildDriveDownloadUrl = (fileId: string): string =>
	`https://drive.google.com/uc?export=download&id=${fileId}`;

const cvDownloadUrl = buildDriveDownloadUrl(cv.fileId);

const expRewrites: { role: string; company: string; description: string }[] = [
	{
		role: "AI Engineer & Senior Software Engineer",
		company: "PT. Berlian Sistem Informasi",
		description:
			"Delivered AI-driven solutions for the Mitsubishi Group — a ChatGPT-class conversational platform with MOM automation, company-specific knowledge delivery, and multilingual translation. Built a CV mobile app that detects bird-droppings on vehicles for paint-damage prevention.",
	},
	{
		role: "Flutter Developer",
		company: "Runchise",
		description:
			"Built a cross-platform Point-of-Sale app for Android, iOS, and Windows — used by hundreds of franchises. Integrated Bluetooth printers, iMin customer displays, and cash drawers.",
	},
	{
		role: "Mobile Developer",
		company: "Telkomsel · Skul.id",
		description:
			"Owned features for Attendance, Permits, Ebook, Scheduling, and Score across Student, Parent, and Teacher roles. BLoC architecture on Flutter, Firebase for the moving parts.",
	},
	{
		role: "Mobile Developer",
		company: "PT. Andal Software Sejahtera",
		description:
			"Refactored the entire HRIS app onto clean architectural patterns while preserving legacy code paths. Built Andal Connect from scratch in Flutter.",
	},
	{
		role: "Android Developer",
		company: "PT. Baboo Teknologi Indonesia",
		description:
			"Built an Android app for generating and reading user-written stories, with Midtrans payments integrated for the marketplace.",
	},
	{
		role: "Android Developer",
		company: "Kargo.co.id",
		description:
			"Designed and delivered a Tracking Management System for logistics operators, plus a customer-facing companion app for booking deliveries.",
	},
];

const tools: { mono: string; name: string }[] = [
	{ mono: "Fl", name: "Flutter" },
	{ mono: "Da", name: "Dart" },
	{ mono: "Kt", name: "Kotlin" },
	{ mono: "Sw", name: "Swift" },
	{ mono: "Fb", name: "Firebase" },
	{ mono: "Py", name: "Python" },
	{ mono: "AI", name: "LLM Apps" },
	{ mono: "BL", name: "BLoC" },
];
---

<Layout title="Steven Siahaan — Mobile Developer">
  <main id="top">
    <!-- ── Hero ── -->
    <section class="hero">
      <div class="frame">
        <span class="hero-eyebrow">Software engineer &amp; AI engineer</span>
        <h1 class="display">Building products that ship.</h1>

        <p class="hero-sub">
          I'm Steven Siahaan — a Jakarta-based engineer with a decade of
          experience shipping Flutter, Android, and iOS products. Today I
          split my time between mobile, AI engineering, and product work for
          teams that want to ship the right thing well.
        </p>

        <div class="cta-row">
          <a class="btn" href="#work"
            >View selected work <span class="arrow">→</span></a
          >
          <a class="btn btn-ghost" href="#contact"
            >Start a project <span class="arrow">→</span></a
          >
        </div>

        <div class="strip">
          <span class="strip-label">Stack</span>
          <div class="strip-items">
            <span>Flutter</span>
            <span>Dart</span>
            <span>Kotlin</span>
            <span>Swift</span>
            <span>Firebase</span>
            <span>Python</span>
            <span>LLM Apps</span>
            <span>BLoC</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── About ── -->
    <section class="section" id="about">
      <div class="frame">
        <div class="about-grid">
          <div class="about-left">
            <span class="section-eyebrow">01 · About</span>
            <h2 class="section-title">A short introduction.</h2>
          </div>

          <div class="about-right">
            <p>
              I build mobile software that people use at work, every day.
              Point-of-sale terminals across hundreds of franchises. School
              platforms used by students, parents, and teachers. HRIS apps
              that quietly handle attendance and leave for thousands of
              employees.
            </p>
            <p>
              The throughline of ten years has been the same: shipping
              cross-platform products that don't break — and lately, doing
              it alongside AI tooling that makes teams faster.
            </p>
            <p>
              I'm currently an AI Engineer &amp; Senior Software Engineer at
              PT. Berlian Sistem Informasi, where I deliver AI-driven
              solutions for the Mitsubishi Group — including a ChatGPT-class
              conversational platform and computer-vision mobile apps.
            </p>

            <div class="about-meta">
              <div class="meta-row">
                <div class="meta-item">
                  <span class="meta-label">Based in</span>
                  <span class="meta-value">Jakarta, Indonesia · UTC+7</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">Currently</span>
                  <span class="meta-value"
                    >AI Engineer &amp; Senior Software Engineer, PT. Berlian
                    Sistem Informasi</span
                  >
                </div>
              </div>
              <div class="meta-row">
                <div class="meta-item">
                  <span class="meta-label">Focus</span>
                  <span class="meta-value">Mobile · AI · Product</span>
                </div>
                <div class="meta-item">
                  <span class="meta-label">Open to</span>
                  <span class="meta-value"
                    >Full-time, contract, advisory</span
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Selected work ── -->
    <section class="section" id="work">
      <div class="frame">
        <div class="section-head">
          <span class="section-eyebrow">02 · Selected work</span>
          <h2 class="section-title">Products I've helped ship.</h2>
        </div>

        <div class="work-grid">
          {
            projects.map((project, i) => (
              <WorkCard
                name={project.name}
                description={project.description}
                url={project.url}
                image={project.image}
                tags={project.tags}
                index={i}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Capabilities ── -->
    <section class="section" id="capabilities">
      <div class="frame">
        <div class="section-head">
          <span class="section-eyebrow">03 · Capabilities</span>
          <h2 class="section-title">What I can help with.</h2>
        </div>

        <div class="caps">
          <article class="cap">
            <div class="cap-num">a.</div>
            <h3 class="cap-title">Flutter, end-to-end</h3>
            <p class="cap-desc">
              Greenfield architecture (BLoC, Riverpod), hardware integrations
              — Bluetooth printers, customer displays, cash drawers — and
              production retail deployments.
            </p>
          </article>
          <article class="cap">
            <div class="cap-num">b.</div>
            <h3 class="cap-title">Native Android &amp; iOS</h3>
            <p class="cap-desc">
              Kotlin and Swift when the platform demands it — payment
              integrations, MVP/MVVM refactors, offline-first patterns.
            </p>
          </article>
          <article class="cap">
            <div class="cap-num">c.</div>
            <h3 class="cap-title">AI engineering</h3>
            <p class="cap-desc">
              Conversational platforms in the spirit of ChatGPT, retrieval
              over private corpora, MOM automation, and multilingual
              document translation.
            </p>
          </article>
          <article class="cap">
            <div class="cap-num">d.</div>
            <h3 class="cap-title">Product management</h3>
            <p class="cap-desc">
              Scoping, roadmapping, and standing between engineers and
              stakeholders so the right thing ships — not just the loudest
              one.
            </p>
          </article>
          <article class="cap">
            <div class="cap-num">e.</div>
            <h3 class="cap-title">Rapid prototyping</h3>
            <p class="cap-desc">
              Fast, opinionated PoCs that prove the idea before the budget.
              R&amp;D-grade software the team can demo on Monday.
            </p>
          </article>
          <article class="cap">
            <div class="cap-num">f.</div>
            <h3 class="cap-title">Cross-platform delivery</h3>
            <p class="cap-desc">
              Single codebases across Android, iOS, and Windows — for
              franchise networks where downtime is measured in revenue lost.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ── Tools ── -->
    <section class="section" id="tools">
      <div class="frame">
        <div class="section-head">
          <span class="section-eyebrow">04 · Tools I use</span>
          <h2 class="section-title">Tools I reach for.</h2>
        </div>

        <p class="tools-desc">
          The tools I reach for when building mobile and AI products — day
          in, day out.
        </p>

        <div class="tools-grid">
          {
            tools.map((tool) => (
              <div class="tool">
                <span class="tool-mono">{tool.mono}</span>
                <span class="tool-name">{tool.name}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Experience ── -->
    <section class="section" id="experience">
      <div class="frame">
        <div class="section-head">
          <span class="section-eyebrow">05 · Experience</span>
          <h2 class="section-title">Where I've worked.</h2>
        </div>

        <div class="exp-list">
          {
            experiences.map((exp, i) => {
              const rw = expRewrites[i] ?? {
                role: exp.role,
                company: exp.company,
                description: exp.description,
              };
              return (
                <article class="exp">
                  <span class="exp-dates">{exp.dates}</span>
                  <div>
                    <h4 class="exp-role">{rw.role}</h4>
                    <div class="exp-company">{rw.company}</div>
                    <p class="exp-desc">{rw.description}</p>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- ── CV ── -->
    <section class="section" id="cv">
      <div class="frame">
        <div class="cv-card">
          <div class="cv-left">
            <span class="section-eyebrow">06 · CV</span>
            <h2 class="cv-heading">Grab the CV.</h2>
            <p class="cv-blurb">{cv.description}</p>
          </div>
          <a
            class="btn"
            href={cvDownloadUrl}
            target="_blank"
            rel="noopener"
            aria-label={cv.ariaLabel}
          >
            {cv.label} <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- ── Contact ── -->
  <section class="contact" id="contact">
    <div class="frame">
      <span class="section-eyebrow">07 · Contact</span>
      <h2 class="contact-title">Have something worth building?</h2>
      <p class="contact-blurb">
        I take on a small number of mobile and AI engagements each year —
        full-time, contract, or advisory. The fastest path is email;
        LinkedIn works too.
      </p>
      <a class="btn" href="mailto:stevenjhsiahaan@gmail.com"
        >Email me <span class="arrow">→</span></a
      >

      <div class="contact-links">
        <a class="ch" href="mailto:stevenjhsiahaan@gmail.com">
          <span class="ch-label">Email</span>
          <span class="ch-value"
            >stevenjhsiahaan@gmail.com <span class="ch-arrow">↗</span></span
          >
        </a>
        <a
          class="ch"
          href="https://linkedin.com/in/stevensiahaan"
          target="_blank"
          rel="noopener"
        >
          <span class="ch-label">LinkedIn</span>
          <span class="ch-value"
            >/in/stevensiahaan <span class="ch-arrow">↗</span></span
          >
        </a>
        <a
          class="ch"
          href="https://github.com/stevensiahaan"
          target="_blank"
          rel="noopener"
        >
          <span class="ch-label">GitHub</span>
          <span class="ch-value"
            >@stevensiahaan <span class="ch-arrow">↗</span></span
          >
        </a>
        <a class="ch" href="#">
          <span class="ch-label">Location</span>
          <span class="ch-value"
            >Jakarta, Indonesia <span class="ch-arrow">↗</span></span
          >
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ─── Hero ─── */
  .hero {
    padding: 120px 0 100px;
    border-bottom: 1px solid var(--rule);
  }
  .hero-eyebrow {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 28px;
  }
  h1.display {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(48px, 7vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0 0 28px;
    max-width: 18ch;
    text-wrap: balance;
  }
  .hero-sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 58ch;
    margin: 0 0 40px;
  }
  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  @media (max-width: 600px) {
    .cta-row {
      flex-direction: column;
      align-items: stretch;
    }
    .cta-row :global(.btn) {
      justify-content: center;
    }
  }

  .strip {
    display: flex;
    align-items: center;
    gap: 36px;
    margin-top: 80px;
    padding-top: 32px;
    border-top: 1px solid var(--rule);
    flex-wrap: wrap;
  }
  .strip-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .strip-items {
    display: flex;
    flex-wrap: wrap;
    gap: 28px 36px;
    flex: 1;
  }
  .strip-items span {
    font-size: 14px;
    color: var(--ink-soft);
    font-weight: 500;
  }

  /* ─── Section base ─── */
  .section {
    padding: 120px 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 720px) {
    .section {
      padding: 72px 0;
    }
  }

  .section-head {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
    align-items: baseline;
    margin-bottom: 64px;
  }
  @media (max-width: 720px) {
    .section-head {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 40px;
    }
  }
  .section-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 22ch;
  }

  /* ─── About ─── */
  .about-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 48px;
  }
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  .about-left {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .about-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .about-right p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0;
    max-width: 62ch;
  }
  .about-meta {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 8px;
  }
  .meta-row {
    display: flex;
    gap: 32px;
  }
  .meta-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .meta-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .meta-value {
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink);
  }
  @media (max-width: 600px) {
    .meta-row {
      flex-direction: column;
      gap: 20px;
    }
  }

  /* ─── Work grid ─── */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 32px;
  }
  @media (max-width: 900px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ─── Capabilities ─── */
  .caps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 32px;
  }
  @media (max-width: 900px) {
    .caps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .caps {
      grid-template-columns: 1fr;
    }
  }
  .cap-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    margin-bottom: 18px;
    letter-spacing: 0.06em;
  }
  .cap-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 25px;
    line-height: 1.1;
    margin: 0 0 12px;
  }
  .cap-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
  @media (max-width: 600px) {
    .cap-title {
      font-size: 22px;
    }
    .cap-desc {
      font-size: 14px;
    }
  }

  /* ─── Tools ─── */
  .tools-desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 640px;
    margin: 0 0 40px;
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 16px;
  }
  @media (max-width: 900px) {
    .tools-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }
  }
  .tool {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 116px;
    border: 1px solid var(--rule);
    border-radius: 20px;
    background: #fff;
  }
  @media (max-width: 900px) {
    .tool {
      height: 88px;
      border-radius: 16px;
      gap: 5px;
    }
  }
  .tool-mono {
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1;
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .tool-mono {
      font-size: 22px;
    }
  }
  .tool-name {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
  }
  @media (max-width: 900px) {
    .tool-name {
      font-size: 9px;
    }
  }

  /* ─── Experience ─── */
  .exp-list {
    display: flex;
    flex-direction: column;
  }
  .exp {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 40px;
    padding: 28px 0;
    border-top: 1px solid var(--rule);
  }
  .exp:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .exp-dates {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-mute);
    letter-spacing: 0.04em;
  }
  .exp-role {
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1.15;
    margin: 0 0 6px;
    font-weight: 400;
  }
  .exp-company {
    font-size: 13px;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 10px;
  }
  .exp-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0;
  }
  @media (max-width: 900px) {
    .exp {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  /* ─── CV ─── */
  .cv-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    padding: 48px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 16px;
  }
  .cv-left {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 560px;
  }
  .cv-heading {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .cv-blurb {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
  @media (max-width: 720px) {
    .cv-card {
      flex-direction: column;
      align-items: stretch;
      padding: 32px;
      gap: 24px;
    }
    .cv-heading {
      font-size: 32px;
    }
    .cv-card :global(.btn) {
      justify-content: center;
    }
  }

  /* ─── Contact ─── */
  .contact {
    padding: 120px 0;
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
  }
  .contact-title {
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 20px 0 24px;
    font-weight: 400;
    max-width: 16ch;
  }
  .contact-blurb {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 640px;
    margin: 0 0 32px;
  }
  .contact-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 32px;
    margin-top: 64px;
  }
  .ch {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 4px;
    border-top: 1px solid var(--rule);
  }
  .ch:hover .ch-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }
  .ch-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ch-value {
    font-size: 16px;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ch-arrow {
    color: var(--ink-mute);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
    font-size: 14px;
  }
  @media (max-width: 600px) {
    .contact-links {
      grid-template-columns: 1fr;
    }
    .contact :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
