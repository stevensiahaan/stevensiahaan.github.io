---
import menus from "../collections/menu.json";
---

<header class="nav">
  <div class="frame nav-row">
    <a class="brand" href="/#top">
      <span>Steven Siahaan</span>
    </a>
    <nav class="nav-links">
      {menus.map((menu) => <a href={menu.url}>{menu.name}</a>)}
    </nav>
    <a class="nav-cta" href="/#contact">Get in touch →</a>

    <details class="mobile-nav">
      <summary aria-label="Open menu">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </summary>
      <div class="mobile-nav-panel">
        {menus.map((menu) => <a href={menu.url}>{menu.name}</a>)}
        <a class="mobile-nav-cta" href="/#contact">Get in touch →</a>
      </div>
    </details>
  </div>
</header>

<style>
  header.nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
  }
  .brand {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav-links {
    display: flex;
    gap: 32px;
  }
  .nav-links a {
    font-size: 14px;
    color: var(--ink-soft);
    transition: color 0.18s ease;
  }
  .nav-links a:hover {
    color: var(--ink);
  }
  .nav-cta {
    font-size: 13px;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    transition: background 0.18s ease;
  }
  .nav-cta:hover {
    background: var(--accent);
  }

  .mobile-nav {
    display: none;
    position: relative;
  }
  .mobile-nav summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 24px;
    height: 24px;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav summary::marker {
    content: "";
  }
  .menu-bar {
    display: block;
    height: 2px;
    background: var(--ink);
    border-radius: 1px;
  }
  .mobile-nav-panel {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    display: flex;
    flex-direction: column;
    min-width: 200px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 10px;
    box-shadow: 0 16px 36px rgba(14, 17, 22, 0.12);
  }
  .mobile-nav-panel a {
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--ink-soft);
    transition: background 0.15s ease;
  }
  .mobile-nav-panel a:hover {
    background: var(--surface);
    color: var(--ink);
  }
  .mobile-nav-cta {
    margin-top: 4px;
    text-align: center;
    font-weight: 500;
    background: var(--ink);
    color: #fff !important;
  }
  .mobile-nav-cta:hover {
    background: var(--accent);
  }

  @media (max-width: 720px) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
  }
</style>
