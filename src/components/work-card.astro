---
interface Props {
	name: string;
	description: string;
	url: string;
	image?: string;
	tags?: string[];
	index: number;
}

const { name, description, url, image, tags = [], index } = Astro.props;

const isExternal = url.startsWith("http");
const num = String(index + 1).padStart(2, "0");
---

<article class="work">
  {
    image && (
      <div class="work-media">
        <img src={image} alt={`${name} — screenshot`} loading="lazy" />
      </div>
    )
  }

  <span class="work-num">{num}</span>

  {
    isExternal ? (
      <a class="work-name" href={url} target="_blank" rel="noopener">
        {name}
      </a>
    ) : (
      <span class="work-name">{name}</span>
    )
  }

  <p class="work-desc">{description}</p>

  {tags.length > 0 && <p class="work-tags">{tags.join(" · ")}</p>}
</article>

<style>
  .work {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .work-media {
    width: 100%;
    height: 230px;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--rule);
    background: var(--surface);
  }
  @media (max-width: 600px) {
    .work-media {
      height: 200px;
    }
  }
  .work-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .work:hover .work-media img {
    transform: scale(1.03);
  }

  .work-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    letter-spacing: 0.08em;
  }
  .work-name {
    font-family: var(--serif);
    font-size: 27px;
    line-height: 1.1;
    transition: color 0.2s ease;
  }
  .work:hover .work-name {
    color: var(--accent);
  }
  .work-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
  .work-tags {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-mute);
    letter-spacing: 0.02em;
    margin: 0;
  }
</style>
